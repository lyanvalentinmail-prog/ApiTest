# Nunca publiques este archivo con una clave real.
AIMLAPI_API_KEY=pega_tu_clave_aqui

# Modelos por defecto. Cualquier ID vigente de https://api.aimlapi.com/v1/models sirve.
DEFAULT_TEXT_MODEL=google/gemma-3-4b-it
DEFAULT_IMAGE_MODEL=flux-pro

# Vinculación: qr (predeterminado) o pairing. --qr / --pairing tiene prioridad.
LINK_METHOD=qr
# Solo es necesario para pairing; dígitos con código de país, sin + ni espacios.
PAIRING_NUMBER=

# Números en formato internacional, separados por coma. Ejemplo: 5215551234567
OWNER_NUMBERS=
PREMIUM_NUMBERS=

# Límite diario para .chat y .ask de cuentas no premium. Los dueños no tienen límite.
DAILY_LIMIT=10

# Por seguridad se ignoran mensajes enviados por la misma cuenta vinculada.
# Cámbialo a true solo si quieres ejecutar comandos desde "Mensaje para ti".
ALLOW_SELF_COMMANDS=false

# Personalización opcional
BOT_NAME=୨୧ AI
# Usa BOT_PREFIX, no PREFIX: Termux reserva PREFIX para su ruta de instalación.
BOT_PREFIX=.
SESSION_DIR=sessions/baileys
DATA_FILE=data/state.json
